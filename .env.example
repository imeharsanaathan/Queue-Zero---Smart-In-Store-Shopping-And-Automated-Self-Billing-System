# Server-only Supabase credentials. NEVER expose the secret key to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SUPABASE_SECRET_KEY

# Legacy Supabase projects may provide this instead; the app accepts it as a fallback.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Optional: only needed later if you replace the demo payment with a real gateway.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
